# Copy this file to ".env" and fill in your values. Never share your .env file.

# --- Basic ---
NODE_ENV=production
PORT=3000
# Your website address (used in the WhatsApp alert link), e.g. https://priyakitchen.in
PUBLIC_URL=
# Long random text used to keep logins safe. Type any 40+ random letters/numbers.
JWT_SECRET=change-this-to-a-long-random-text-1234567890abcdef
# Password for your admin page at /admin
ADMIN_PASSWORD=change-this-password
# Where the database file is stored (on Railway, set this to the volume path, e.g. /data)
DATA_DIR=./data

# --- Your WhatsApp number for new-order alerts (country code + number, no +) ---
OWNER_WHATSAPP=919140762014

# Choose how alerts are sent: callmebot (free, easiest) or meta (official WhatsApp Business API)
WHATSAPP_PROVIDER=callmebot
# CallMeBot: API key you get after the one-time WhatsApp activation (see README)
CALLMEBOT_API_KEY=
# Meta WhatsApp Cloud API (only if WHATSAPP_PROVIDER=meta)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=new_order_alert
META_WA_TEMPLATE_LANG=en

# --- Direct UPI payments (used when Razorpay keys are empty) ---
# Your UPI ID that customers pay to, e.g. priyakitchen@okaxis
UPI_ID=
UPI_NAME=Priya Kitchen

# --- Razorpay (optional — leave empty to use direct UPI) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you choose (recommended)
RAZORPAY_WEBHOOK_SECRET=

# --- OTP SMS via 2Factor.in (optional — leave empty and customers log in with a 4-digit PIN) ---
TWOFACTOR_API_KEY=
# Optional: your approved OTP template name in 2Factor
TWOFACTOR_TEMPLATE=

# --- Testing only. Shows the OTP on screen and fakes payment. Keep false on the live site. ---
DEMO_MODE=false
